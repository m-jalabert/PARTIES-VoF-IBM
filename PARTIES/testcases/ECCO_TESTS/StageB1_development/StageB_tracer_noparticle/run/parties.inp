# Stage-B 2-D release shakeout (roadmap B.1.3/B.1.4/B.1.5).
#
# Purpose: exercise the FULL coupled chain -- horizontal ice layer melting from
# below, a resolved sediment grain locked in the ice, interface-triggered
# release, and the meltwater tracer -- cheaply enough to iterate on.  This is a
# code shake-out, NOT science: Pe_T is deliberately 20x smaller than the
# Stage-A value so the melt front reaches the grain in ~10 time units instead
# of ~300.
#
# Geometry: ice occupies y > 0.6 (VOF init 28), warm water below.  The grain
# sits at y = 0.66 with R = 0.04, i.e. spanning 0.62..0.70 -- fully inside the
# ice at t = 0, with ~0.02 of ice below it.  The front melts upward past it.
[geometry]
xmin = 0.0
xmax = 1.0
ymin = 0.0
ymax = 1.0
zmin = 0.0
zmax = 0.00390625
twod_slab_thickness = 0.00390625

[grid]
NXM = 256
NYM = 256
NZM = 1
ImportGridFromFile = 0

[simulation]
time_max = 15.0
output_time_interval = 0.5
output_time_interval_2d = 0.5
default_dt = 0.0005
max_dt = 0.0025
constant_dt = 0
cfl = 0.3
ghost_nodes = 3
resume = 0
freeze_velocity = 0

[flow]
Re = 500.0
vel_init_type = 0
dp_dx = 0.0
ubulk_target = 0.0
startup_time = 0.0
startup_init = 0
startup_velocity = {0.0, 0.0, 0.0}

[vof]
We = 1.0e30
rho1 = 1.0
rho2 = 1.0
mu1 = 1.0
mu2 = 1.0
init_type = 28
vof_slab_x0 = 0.6
Cn = 0.0029296875
Pe_CH = 307.2
darcy_tau = 1.0e-4
weno_order = 5
ch_iter_max = 3000
ch_tol = 1.0e-11
contact_angle_deg = 90.0

[phase_change]
stefan = 0.25
T_melt = 0.0
liquidus_slope = 0.014
melt_band_eps = 0.0029296875
# B.1.4: concentration field 2 is a meltwater tracer injected at the melt rate.
# Conservation check: d/dt integral(C_mw) must equal d/dt integral(F).
meltwater_tracer = 1

[eos]
eos_q = 2.0
eos_betaT = 1.0
eos_betaS = 1.75
eos_Tmd0 = 0.2
eos_Tmd_slope = -0.0625

[conc]
# 0 = temperature, 1 = salinity (inert here: freshwater shakeout), 2 = meltwater
NConc = 3
Nbin = 1000
Pe = {500.0, 5000.0, 500.0}
richardson = {0.0, 0.0, 0.0}
V_s0 = {0.0, 0.0, 0.0}
vol_heat_cap_s = {1.0, 1.0, 1.0}
conductivity_s = {1.0, 1.0, 1.0}
kappa_ice_ratio = {1.0, 0.0, 0.0}
conc_init_type = {34, 35, 0}
cbd0 = 1.0
cbd1 = 0.0
theta_ice = 0.0
cbd2 = 0.0
cbd5 = 0.0
BC_AW = {1.0, 1.0, 1.0}
BC_BW = {0.0, 0.0, 0.0}
BC_CW = {0.0, 0.0, 0.0}
BC_AE = {1.0, 1.0, 1.0}
BC_BE = {0.0, 0.0, 0.0}
BC_CE = {0.0, 0.0, 0.0}
BC_AN = {1.0, 1.0, 1.0}
BC_BN = {0.0, 0.0, 0.0}
BC_CN = {0.0, 0.0, 0.0}
BC_AS = {1.0, 1.0, 1.0}
BC_BS = {0.0, 0.0, 0.0}
BC_CS = {0.0, 0.0, 0.0}
BC_AF = {1.0, 1.0, 1.0}
BC_BF = {0.0, 0.0, 0.0}
BC_CF = {0.0, 0.0, 0.0}
BC_AB = {1.0, 1.0, 1.0}
BC_BB = {0.0, 0.0, 0.0}
BC_CB = {0.0, 0.0, 0.0}

[particle]
# Sediment grain: denser than water, so it sinks once freed.
rho_s = 2.5
rho_prImp = 2.5
grav = {0.0, -1.0, 0.0}
N_forcing_loops = 1
N_heating_loops = 0
N_impheating_loops = 0
# B.1.3 interface-triggered release.  F_release = 0.9 means "release once 90%
# of the grain's immediate neighbourhood is liquid", i.e. essentially free
# rather than still half-keyed into the ice.
F_release = 0.9
release_shell_cells = 2.0
release_ramp_steps = 10

[lsolve]
P_CG_ETOL = 1.0e-10
P_CG_MAXIT = 2500
CG_ETOL = 1.0e-7
CG_MAXIT = 2500

[output]
ave_height_output = 0
front_location_output = 0
front_speed_output = 0
susp_mass_output = 0
sedim_rate_output = 0
energies_output = 0
shear_stress_output = 0
conc_output_integral = {0, 0, 0}
conc_output_Q_int = {0, 0, 0}
output_vfc = 1
output_vfu = 0
output_vfv = 0
output_vfw = 0
avg_dir = 1
nusselt_switch = 0
turbulent_terms_switch = 0
post_processing_switch = 0
near_wall_slice_switch = 0
slice_axis = 2
slice_half = 1
slice_pos = 1
slice_p = 0
center_two_particles = 0
