[simulation]
time_max = 0.5
output_time_interval = 0.5
default_dt = 5e-4
max_dt = 5e-4
constant_dt = 1


[particle]
grav = {0, -1, 0}  # {a,b,c,..} notion for a list
rho_s = 2;
