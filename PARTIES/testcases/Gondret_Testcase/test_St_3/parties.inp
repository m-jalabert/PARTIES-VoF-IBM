# parties.inp file for Gondret St = 27 test case
[geometry]
xmin = 0
xmax = 2
ymin = 0
ymax = 2
zmin = 0
zmax = 2


[grid]
NXM = 50
NYM = 50
NZM = 50


[flow]
Re = 13.5
ubulk_target = 0

# Startup flag variables
startup_init = 0
