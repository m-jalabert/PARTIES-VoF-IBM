#!/bin/bash
## The first line (above) specifies the shell to use for parsing 
## the remaining lines of the batch script.
#
## Required PBS Directives --------------------------------------
#PBS -A ARLAP44862H70 
#PBS -q debug
#PBS -l select=2:ncpus=44:mpiprocs=44
#PBS -l walltime=00:30:00
#PBS -l application=PARTIES
#
## Optional PBS Directives --------------------------------------
#PBS -N Gondret27
#PBS -j oe
#PBS -V
#PBS -S /bin/bash
#
## Execution Block ----------------------------------------------
# Environment Setup

module load cray-fftw
module load cray-hdf5
# cd to your personal directory in the scratch file system
cd $WORKDIR/PARTIES/PARTIES
#
make clean
make
# Launching
# copy executable from $HOME and submit it
aprun -n 88 -N 44 ./parties
#
