
# Among other things, defines:
#   SRC_SUB_DIRS     - (rel) names of subdirectories
#   SRC_INCLUDES     - (abs) directories containing header files
#   SRC_OBJ_ROOT_DIR - (rel) path to object directory root
#   SRC_OBJECTS      - (rel) objects in local directory
#   SRC_ALL_OBJECTS  - (rel) objects in local and sub-directories

# Add new directories here
#-----------------------------------------------------------

# Directories to search for other source files
SRC_SUB_DIRS := IO Eulerian Lagrangian Turb_model tools

#-----------------------------------------------------------

# Relative and absolute path to src directory
SRC_DIR_REL := $(dir $(lastword $(MAKEFILE_LIST)))
SRC_DIR_ABS := $(CURDIR)/$(SRC_DIR_REL)

# Directories of include files
SRC_INCLUDES := $(SRC_DIR_ABS)Include
SRC_INCLUDES += $(foreach subdir,$(SRC_SUB_DIRS),$(SRC_DIR_ABS)$(subdir)/Include)
SRC_INCLUDES := $(abspath $(SRC_INCLUDES))

# Location for object directory
SRC_OBJ_ROOT_DIR := ../obj

# Source files and objects for local directory
SRC_OBJ_DIR := $(SRC_OBJ_ROOT_DIR)
SRC_SOURCES := $(wildcard $(SRC_DIR_REL)*.c)
SRC_OBJECTS := $(patsubst $(SRC_DIR_REL)%.c, $(SRC_OBJ_DIR)/%.o, $(SRC_SOURCES))

# Source files and objects, including subdirectories
SRC_ALL_SOURCES := $(SRC_SOURCES)
SRC_ALL_SOURCES += $(foreach subdir,$(SRC_SUB_DIRS),$(wildcard $(SRC_DIR_REL)$(subdir)/*.c))
SRC_ALL_OBJECTS := $(patsubst $(SRC_DIR_REL)%.c, $(SRC_OBJ_DIR)/%.o, $(SRC_ALL_SOURCES))
