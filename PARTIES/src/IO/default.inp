/******************************************************************************/
/*                                  GEOMETRY                                  */
/*----------------------------------------------------------------------------*/
/*    Mesh and physical properties of the domain                              */
/******************************************************************************/
CFG(geometry, xmin, 0.0, atof) // x: left position
CFG(geometry, xmax, 1.0, atof) // x: right position
CFG(geometry, ymin, 0.0, atof) // y: bottom position
CFG(geometry, ymax, 1.0, atof) // y: top position
CFG(geometry, zmin, 0.0, atof) // z: back position
CFG(geometry, zmax, 1.0, atof) // z: front position


/******************************************************************************/
/*                                    GRID                                    */
/*----------------------------------------------------------------------------*/
/*    Grid properties                                                         */
/******************************************************************************/
CFG(grid, NXM, 64, atoi)              // number of grid points in x direction
CFG(grid, NYM, 64, atoi)               // number of grid points in y direction
CFG(grid, NZM, 64, atoi)               // number of grid points in z direction
CFG(grid, ImportGridFromFile, 0, atoi) // Import grid from file? (YES/NO -> 1/0)

/******************************************************************************/
/*                                   2D MODES                                 */
/*----------------------------------------------------------------------------*/
/*    Shared configuration for planar and axisymmetric slab storage           */
/******************************************************************************/
CFG(twod, axisym_theta_cells, 1, atoi)
CFG(twod, axisym_theta_span, 6.283185307179586, atof)
CFG(twod, twod_slab_thickness, -1.0, atof)


/******************************************************************************/
/*                                 SIMULATION                                 */
/*----------------------------------------------------------------------------*/
/*    Simulation and Run properties                                           */
/******************************************************************************/
CFG(simulation, time_max, 25.0, atof)        // Maximum time
CFG(simulation, output_time_interval, 0.5, atof) // Time interval between output files
CFG(simulation, output_time_interval_2d, 0.5, atof) // Time interval between output files
CFG(simulation, default_dt, 0.001, atof)     // Initial timestep
CFG(simulation, max_dt, 0.05, atof)           // Maximum allowable dt
CFG(simulation, constant_dt, 0, atoi)        // Use constant time step? 0 = CFL condition, 1 = default timestep
CFG(simulation, cfl, 0.5, atof)              // CFL number
CFG(simulation, ghost_nodes, 3, atoi)        // Ghost nodes
CFG(simulation, resume, 0, atoi)             // Resume simulation flag


/******************************************************************************/
/*                                    FLOW                                    */
/*----------------------------------------------------------------------------*/
/*    Flow input properties                                                   */
/******************************************************************************/
CFG(flow, Re, 100.0, atof)   // Reynolds number
CFG(flow, G,  1.0, atof)     // Shear parameter
CFG(flow, dp_dx, 0.0, atof)  // Pressure gradient
CFG(flow, ubulk_target, 1.0, atof)      // Desired streamwise bulk velocity
CFG(flow, u_in_left, 1.0, atof)      //
CFG(flow, u_in_right, 1.0, atof)      //
CFG(flow, shear_sigma_u, 1.0, atof)      // Desired shear velocity jump
CFG(flow, shear_sigma_conc, 1.0, atof)      // Desired shear density jump
CFG(flow, delta_jet, 0.1, atof)
CFG(flow, F_jet, 1.0, atof)
CFG(flow, V_swarm, 1.0, atof)
CFG(flow, y_swarm_start, 1.0, atof)
CFG(flow, swarm_rand, 0.001, atof)
CFG(flow, voutflow, 1.0, atof)
CFG(flow, Kf, 2.3, atof)     			 // maximum forced wave number
CFG(flow, Ds, 1e7, atof)     			 // Characteristic dissipation value for the random turbulent process
CFG(flow, t_release, -2.0, atof)
CFG(flow, per_fr, 1.5, atof)

CFG(flow, startup_time, 0.0, atof)		// starting time to release the particle (in STARTUP flag)
CFGArray(flow, startup_velocity, "{0.0, 0.0, 0.0}", GVG_DOUBLE)  // Prescribed velocity which acts on the particle during startup time
CFG(flow, startup_init, 0.0, atof)		// 0 - User defined velocity and startup_time; 1,2 - Gondret testcase St=27 and St = 152

// Oscillation parameters                   with: L, T = length and time scale
CFG(flow, phase_shift_factor, 0.0, atof)	// phase shift of the oscillating force = phase_shift_factor * Pi 
CFG(flow, amplitude_mode, 1, atoi)          // Use which amplitude mode? 1: amplitude = disp_amplitude[L] * (2 * Pi * frequency)^2[1/T^2] ,   0: amplitude = acc_amplitude [L/T^2]
CFG(flow, disp_amplitude, 0.0, atof)        // displacement-amplitude of the oscillation [L]
CFG(flow, acc_amplitude, 0.0, atof)         // acceleration-amplitude of the oscillation [L/T^2]
CFG(flow, frequency, 1.0, atof)             // oscillation frequency [1/T]
CFG(flow, oscillation_frame, 1.0, atof)     // define observer: 0 = inertial (fixed) frame; 1 = non-inertial (accelerated) frame


//------------------------------------------------------------------------------
// Initialization types:
// 0 - zero flow
// 1 - uniform flow profile
// 2 - linear flow profile
// 3 - Poiseuille (parabolic) flow profile
// 4 - rotational shear flow profile
//------------------------------------------------------------------------------
CFG(flow, vel_init_type, 0, atoi)  // Type of initial velocity profile
CFG(flow, vel_init_y0, 0.0, atof)  // y-coordinate to start velocity profile
CFG(simulation, freeze_velocity, 0, atoi)  // Smoke-test: skip momentum/pressure, force u=v=w=0 (1 = on)

/******************************************************************************/ 
/*                                VOF_PLIC                                    */
/*----------------------------------------------------------------------------*/
/*    Volume-of-Fluid (VOF) parameters for a two-phase flow.                  */
/******************************************************************************/
// Non-dimensional parameters for two-phase flow 
CFG(vof, We, 1.0, atof)          // Weber number 

// Fluid properties (dimensionless) 
// E.g. rho = F + (1-F)*rho_2/rho_1, etc.
CFG(vof, rho1, 1.0, atof)        // Primary fluid (F=1)
CFG(vof, rho2, 1.0, atof)        // Secondary fluid (F=0)
CFG(vof, mu1, 1.0, atof)        // Viscosity fluid 1
CFG(vof, mu2, 1.0, atof)       // Viscosity fluid 2

// Interface initialization 
CFG(vof, init_type, 0, atoi)     // 1=Advection test case, 2=Stationary Bubble test case

//Contact angle inputs
CFG(vof, contact_angle_deg, 90.0, atof)

// Diffuse-interface / Cahn-Hilliard controls
CFG(vof, Cn, -1.0, atof)          // If <= 0, set to 0.75 * h_ref in Input.c
CFG(vof, Pe_CH, -1.0, atof)       // If <= 0, set to 0.9 / Cn in Input.c
CFG(vof, weno_order, 5, atoi)     // Advection order for diffuse-interface transport
CFG(vof, ch_iter_max, 300, atoi)  // Max iterations for implicit CH solve
CFG(vof, ch_tol, 1e-9, atof)      // Tolerance for implicit CH solve
CFG(vof, bridge_volume_over_r3, 0.09375, atof) // Rajesh/Sauret bridge target V/R^3

// Test cases
// Rider & Kothe Advection testcase (1998)
CFG(vof, advection_test_time, 0.5, atof)     // Parameter for Time Reversal

// Melting / ice additions (used only under their compile flags in Boundary.h)
CFG(vof, darcy_tau, 1.0e-4, atof)   // ICE_PENALIZATION: Darcy damping timescale
CFG(vof, vof_slab_x0, 0.9, atof)    // init_type 27: ice slab interface at x = vof_slab_x0*Lx


/******************************************************************************/
/*                                    EOS                                     */
/*----------------------------------------------------------------------------*/
/*    Roquet (2015) quadratic equation of state (EOS_NONLINEAR)               */
/*    b(theta,s) = -eos_betaT*(theta - eos_Tmd0 - eos_Tmd_slope*s)^eos_q      */
/*                 + eos_betaS*s                                              */
/******************************************************************************/
CFG(eos, eos_q, 2.0, atof)          // Exponent of the thermal anomaly (Roquet: 2)
CFG(eos, eos_betaT, 1.0, atof)      // Thermal coefficient in free-fall units
CFG(eos, eos_betaS, 0.0, atof)      // Haline coefficient = LambdaT = RaS/RaT
CFG(eos, eos_Tmd0, 0.0, atof)       // Fresh-water density-maximum temperature
CFG(eos, eos_Tmd_slope, 0.0, atof)  // Salinity shift of the density maximum (cS*Sm/dT)


/******************************************************************************/
/*                                PHASE_CHANGE                                */
/*----------------------------------------------------------------------------*/
/*    Stefan melting: V_G = (stefan/Pe_T)*(dtheta/dn|liq - kr*dtheta/dn|sol)  */
/******************************************************************************/
CFG(phase_change, stefan, 0.0, atof)          // St = cp*dT/L (= 1/St_Yang); 0 disables melting
CFG(phase_change, T_melt, 0.0, atof)          // Melting temperature at s = 0
CFG(phase_change, liquidus_slope, 0.0, atof)  // Freezing-point depression m*Sm/dT (NOT eos_Tmd_slope)
CFG(phase_change, melt_band_eps, -1.0, atof)  // Melt-law band scale eps; <= 0 -> use Cn
CFG(phase_change, meltwater_tracer, 0, atoi)  // 1: conc field 2 is a meltwater tracer injected at the melt rate (needs NConc>=3)
CFG(phase_change, yang_salt_transport, 0, atoi) // 1: Yang finite-interface salt flux/rejection terms
CFG(phase_change, yang_salt_delta, 1.0e-6, atof) // Yang regularization delta (authors' value: 1e-6)
CFG(phase_change, liquid_referenced_salinity, 0, atoi) // A.5.5 v1: use s/(F+delta), the LIQUID salinity, in the liquidus and the EOS instead of the volume-averaged s




/******************************************************************************/
/*                                    CONC                                    */
/*----------------------------------------------------------------------------*/
/*    Concentration properties                                                */
/******************************************************************************/
CFG(conc, NConc, 1, atoi)  // Number of concentration fields
CFG(conc, Nbin, 1000, atoi) // Number of bins for histograms
CFGArray(conc, Pe, "{1,1}", GVG_DOUBLE)      // Peclet Number(s)
CFGArray(conc, richardson, "{1,0}", GVG_DOUBLE)   // Initial Maximum Volume Fraction of Each Concentration Field(>0)
CFGArray(conc, V_s0, "{0,0}", GVG_DOUBLE)    // Particle Settling Velocity(ies)(in y-direction):[The 1st one is important. The others will be recalculated]
CFGArray(conc, vol_heat_cap_s, "{1,1}", GVG_DOUBLE)  // vol heat capacity of teh particle normalized by fluid
CFGArray(conc, conductivity_s, "{0,0}", GVG_DOUBLE)  // particle conductivity (diffusivity respectively)
// CONC_VOF_PHASEWEIGHTED: per-field solid(ice)/liquid diffusivity ratio,
// kappa(F) = F + (1-F)*kappa_ice_ratio.  Temperature: finite ratio (heat
// conducts in ice); salt: 0 (no salt flux into ice).
CFGArray(conc, kappa_ice_ratio, "{1,0}", GVG_DOUBLE)
CFG(conc, theta_ice, 0.0, atof)  // conc_init_type 30: initial ice temperature
CFGArray(conc, layer_height, "{0.5, 0.2}", GVG_DOUBLE)  // initial height of conc layer
CFG(conc, sig_profile, 0.1, atof)  // erf profile for init conc
CFG(conc, cbd0, 1.0, atof)  //
CFG(conc, cbd1, 0.0, atof)  //
CFG(conc, cbd2, 0.5, atof)  //
CFG(conc, cbd3, 1.0, atof)  //
CFG(conc, cbd4, 0.0, atof)  //
CFG(conc, cbd5, 0.5, atof)  //
// Conc init 36/37/38 (ECCO B.3 P1b): diffusive sublayer under the horizontal
// ice layer of VOF init 28, zeta = y_int - y (<= 0 in the ice). Used ONLY by
// those init types; the defaults are inert.
//   36 T:      theta_ice + (cbd0 - theta_ice)*erf(zeta/sublayer_ell_T)
//   37 S:      F*[s_i + (cbd5 - s_i)*erf(zeta/sublayer_ell_S)], s_i = sublayer_s_interface
//   38 tracer: F*(1 - s_liquid/cbd5), the meltwater fraction w.r.t. the far water
CFG(conc, sublayer_ell_T, 1.0, atof)
CFG(conc, sublayer_ell_S, 1.0, atof)
CFG(conc, sublayer_s_interface, 1.0, atof)


//Initialization types:
// 0  c=0
// 1 Lock exchange
// 2 triple cos
// 3 triple sin
CFGArray(conc, conc_init_type, "{0,0}" , GVG_INT)		// Initial condition for scalars


/*********************Mixed boundary conditions for the scalar fields****************************/
CFGArray(conc, BC_AN, "{1,1}", GVG_DOUBLE)
CFGArray(conc, BC_AS, "{1,1}", GVG_DOUBLE)
CFGArray(conc, BC_AE, "{1,1}", GVG_DOUBLE)
CFGArray(conc, BC_AW, "{1,1}", GVG_DOUBLE)
CFGArray(conc, BC_AF, "{1,1}", GVG_DOUBLE)
CFGArray(conc, BC_AB, "{1,1}", GVG_DOUBLE)

CFGArray(conc, BC_BN, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_BS, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_BE, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_BW, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_BF, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_BB, "{0,0}", GVG_DOUBLE)

CFGArray(conc, BC_CN, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_CS, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_CE, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_CW, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_CF, "{0,0}", GVG_DOUBLE)
CFGArray(conc, BC_CB, "{0,0}", GVG_DOUBLE)



/******************************************************************************/
/*                                    LOCK                                    */
/*----------------------------------------------------------------------------*/
/*    Lock (initial separator of the two fluids) properties                   */
/******************************************************************************/
CFG(lock, x_fr, 1, atof) // x: initial location of separating sheet: lock
CFG(lock, y_fr, 3.0, atof) // y: initial location of separating sheet: lock
CFG(lock, z_fr, 2.0, atof) // z: initial location of separating sheet: lock
CFG(lock, hlock, 1.0, atof) // x: initial location of separating sheet: lock

CFG(lock, lock_smooth, YES, atoi) // initial condition of the lock ??????


/******************************************************************************/
/*                                  PARTICLE                                  */
/*----------------------------------------------------------------------------*/
/*    Lagrangian Particles                                                    */
/******************************************************************************/


CFG(particle, rho_s, 2.5, atof)  // Particle density (relative to fluid)
CFG(particle, rho_prImp, 2.5, atof)  // Particle density (relative to fluid)

/*    Interface-triggered release of a sediment grain locked in ice (roadmap    */
/*    B.1.3).  A MOBILE particle is held motionless until the melt front has    */
/*    freed it.  F_release <= 0 disables the mechanism, so the DEFAULT BELOW    */
/*    REPRODUCES THE PRE-ECCO BEHAVIOUR EXACTLY and must stay <= 0: raising it  */
/*    would silently start locking particles in every existing deck.            */
/*                                                                              */
/*    Calibrated in B.1.3-fn against how far the melt front has passed the      */
/*    grain (0 = front at its underside, 1 = grain just fully uncovered):       */
/*        F_release = 0.565  ->  half uncovered                                 */
/*        F_release = 0.709  ->  JUST fully uncovered   <-- recommended         */
/*        F_release = 0.867  ->  clear by half a diameter                       */
/*        F_release = 0.900  ->  clear by 0.67 diameters (late/conservative)    */
/*    phi_liq saturates at ~0.977, never 1, so F_release >= F_RELEASE_MAX       */
/*    (0.98) can never fire; that is rejected at startup rather than hanging.   */
CFG(particle, F_release, -1.0, atof)        // Shell liquid fraction that frees a grain; <=0 = off (pre-ECCO default)
CFG(particle, release_shell_cells, 2.0, atof) // Shell thickness outside R, in cells, that the criterion averages over
CFG(particle, release_ramp_steps, 10, atoi)   // Steps over which the freed grain's IBM constraint is ramped in
CFGArray(particle, grav, "{0,-1,0}", GVG_DOUBLE)  // Gravitational acceleration
CFG(particle, e_dry_wall, 0.97, atof)  // Coefficient of restitution of wall
CFG(particle, e_dry_particles, 0.97, atof)  // Coeff. of restitution of particles
CFG(particle, Ndt_coll, 10, atoi)     // Number of fluid timesteps per collision
CFG(particle, mu_k, 0.15, atof)       // Kinetic coefficient of friction
CFG(particle, mu_s, 0.8, atof)        // Static coefficient of friction
CFG(particle, PoissonsRatio, 0.22, atof)  // Poisson's ratio
CFG(particle, Psi_crit, 1.0, atof)    // Critical non-dim angle for sliding
CFG(particle, roughness, 3e-3, atof)  // Fraction of radius to limit lubrication
CFG(particle, lub_range, 2.0, atof)  // Range of lubrication force divided by grid cell size
CFG(particle, erm_range, 4.0, atof)  // Range of electrostatic force divided by grid cell size
CFG(particle, F_erm, 3.1415926536, atof)  // Electrostatic repulsion coefficient
CFG(particle, B1, 1.5, atof)  // Squirmer model velocity constant 1
CFG(particle, B2, 0.0, atof)  // Squirmer model velocity constant 2
CFGArray(particle, target_coord, "{0,0,0}", GVG_DOUBLE)  // Coordinate of swimming target
CFG(particle, target_on, 0, atoi)  // Swimming towards target (0 or 1)
CFG(particle, y_cut, 1.0,atof) // Vertical position where swimmer is turned off
CFG(particle, coefA, 0.0, atof)  // z coordinate of swimming target
CFG(particle, coh_range, 1.0, atof)  // Range of cohesive force divided by grid cell size
CFG(particle, D50, 1.0      ,atof)   //Median grain size diameter
CFG(particle, Co, 0.0,atof)          //Cohesive Number
CFG(particle, bl_thick, 0.0,atof)          //Thickness of smoothing bl around swimmers


CFG(particle, N_forcing_loops, 2, atoi)  // Extra loops for enforcing no-slip
// modeling of the scalar fields
CFG(particle, N_heating_loops, 0, atoi)  // Extra loops for enforcing conc BC
CFG(particle, N_impheating_loops, 1, atoi)  // Implicit loops for enforcing conc BC







/******************************************************************************/
/*                                   LSOLVE                                   */
/*----------------------------------------------------------------------------*/
/*    Linear system of equation-solver properties                             */
/******************************************************************************/
CFG(lsolve, P_CG_ETOL, 1e-7, atof) // Error tolerance for pressure conjugate-gradient solver
CFG(lsolve, P_CG_MAXIT, 300, atoi)  // Max iterations for pressure conjugate-gradient solver
CFG(lsolve, CG_ETOL, 1e-9, atof) // Error tolerance for conjugate-gradient solver
CFG(lsolve, CG_MAXIT, 120, atoi)  // Max iterations for conjugate-gradient solver


/******************************************************************************/
/*                                   OUTPUT                                   */
/*----------------------------------------------------------------------------*/
/*    Flags indicating flow properties to be saved to file   (YES/NO -> 1/0)  */
/******************************************************************************/
CFG(output, avg_dir, 1, atoi)  // covar calculation direction
CFG(output, ave_height_output, NO, atoi)     // Average height
CFG(output, front_location_output, NO, atoi) // front location
CFG(output, front_speed_output, NO, atoi)    // front speed
CFG(output, susp_mass_output, NO, atoi)      // Suspended mass
CFG(output, sedim_rate_output, NO, atoi)     // Sedimentation Rate
CFG(output, energies_output, NO, atoi)
CFG(output, shear_stress_output, NO, atoi)


CFGArray(output, conc_output_deposit_height , "{0}" , GVG_INT)		// Switch for Output
CFGArray(output, conc_output_dump, "{0}" , GVG_INT)		// Switch for Output
CFGArray(output, conc_output_stokes_diss_rate, "{0}" , GVG_INT)		// Switch for Output
CFGArray(output, conc_output_integral, "{0}" , GVG_INT)
CFGArray(output, conc_output_Q_int, "{0}" , GVG_INT)

CFGArray(output, chunk_size, "{0, 0, 0}", GVG_INT)  // chunk dims for 3D data in Data_*.h5 files

CFG(output, output_vfu, NO, atoi)     // particle indicator function
CFG(output, output_vfv, NO, atoi)     // particle indicator function
CFG(output, output_vfw, NO, atoi)     // particle indicator function
CFG(output, output_vfc, NO, atoi)     // particle indicator function

// SLICE_OUTPUT
CFG(output, slice_axis, 2, atoi)      // Specification of the axis to be sliced: 0=X, 1=Y, 2=Z
CFG(output, slice_half, 1, atoi)      // Slice in the center of the specified slicing axis: 1=yes; 0=no -> if no, specify slice_position
CFG(output, slice_pos, 1, atoi)       // If slice_half=0 -> grid point number for slicing position
CFG(output, slice_p, 0, atoi)         // Specifiy if pressure field should be sliced: 0=no; 1=yes
CFG(output, center_two_particles, 0, atoi)  // For two particles, specify whether the slicing should be performed in the center 
                                            // between the particles along X-axis: 0=no; 1=yes; Only valid when slice_axis = 0

/*  For statistics2d  */



CFG(output, front_position_switch, YES, atoi)     // height of a gravity current
CFG(output, current_height_switch, YES, atoi)     // height of a gravity current
CFG(output, nusselt_switch, YES, atoi)     // height of a gravity current
CFG(output, turbulent_terms_switch, YES, atoi)
CFG(output, post_processing_switch, NO, atoi)
CFG(output, near_wall_slice_switch, YES, atoi)

/******************************************************************************/
/*          Miscellaneous                                                     */
/******************************************************************************/
/* Flag indicating if the bottom interface should be imported from file */
CFG(misc, ImportBottomInterface, NO, atoi)
